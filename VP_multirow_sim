<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stage 05 — FEA, CFD, Thermal & Lighting Simulation Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f5f5f4; color: #1c1917; }
        .serif-title { font-family: 'Playfair Display', serif; }
        .mono-text { font-family: 'JetBrains Mono', monospace; }
        .sim-tab-btn.active { background-color: #1c1917; color: #ffffff; border-color: #1c1917; }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-xl border border-stone-200 overflow-hidden">
        <header class="bg-stone-900 text-white p-6 md:p-8 border-b border-stone-800 flex justify-between items-center">
            <div>
                <span class="text-xs font-semibold tracking-widest text-amber-400 uppercase bg-amber-950/50 px-3 py-1 rounded-full">Doctoral Appendix — Stage 05</span>
                <h1 class="serif-title text-2xl md:text-3xl font-bold mt-2 text-stone-100">FEA, CFD Venturi, Thermal & Daylight Simulation Suite</h1>
                <p class="text-stone-400 text-sm mt-1">Granular localized void manipulation with real-time FEA, CFD Venturi airflow, thermal cooling, and point-by-point illumination solvers.</p>
            </div>
            <a href="index.html" class="bg-stone-800 hover:bg-stone-700 text-stone-200 text-xs font-semibold py-2.5 px-4 rounded-lg border border-stone-700 transition">
                &larr; Return to Dashboard
            </a>
        </header>

        <div class="flex flex-col lg:flex-row divide-y lg:divide-y-0 lg:divide-x divide-stone-200">
            
            <!-- CONTROLS SIDEBAR -->
            <div class="w-full lg:w-1/3 p-6 bg-stone-50/50 space-y-6 flex-shrink-0">
                <div>
                    <h2 class="text-sm font-bold text-stone-800 uppercase tracking-wider mb-4">1. Global Geometry Constraints</h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Side Length (s) cm</label>
                            <input id="sideInput" type="number" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="30">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Wall Frame (gap) cm</label>
                            <input id="gapInput" type="number" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="5">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Mating Depth (t) cm</label>
                            <input id="thicknessInput" type="number" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="2">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Default Void % (Max 37.24%)</label>
                            <input id="defaultVpInput" type="number" min="0.1" max="37.24" step="0.1" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="15">
                        </div>
                    </div>
                </div>

                <div>
                    <h2 class="text-sm font-bold text-stone-800 uppercase tracking-wider mb-3">2. Climate & Building Bounds</h2>
                    
                    <div class="mb-4 p-2.5 bg-stone-200/60 rounded-lg space-y-1.5">
                        <span class="text-[10px] font-bold text-stone-600 uppercase block">Preset Climate Suggestions:</span>
                        <div class="flex flex-wrap gap-1.5">
                            <button id="presetHotDry" type="button" class="text-[10px] bg-stone-800 text-white px-2 py-1 rounded hover:bg-stone-900 transition">Hot-Dry Summer</button>
                            <button id="presetComposite" type="button" class="text-[10px] bg-stone-700 text-white px-2 py-1 rounded hover:bg-stone-800 transition">Composite Clear</button>
                            <button id="presetMonsoon" type="button" class="text-[10px] bg-stone-600 text-white px-2 py-1 rounded hover:bg-stone-700 transition">Monsoon Overcast</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Columns</label>
                            <input id="colsInput" type="number" min="1" max="12" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="6">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Rows</label>
                            <input id="rowsInput" type="number" min="1" max="6" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="3">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Façade Orientation</label>
                            <select id="orientationInput" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white">
                                <option value="North">North (Diffused Light)</option>
                                <option value="South" selected>South (High Solar Gain)</option>
                                <option value="East">East (Morning Direct)</option>
                                <option value="West">West (Afternoon Direct)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Wind Angle (°)</label>
                            <input id="windAngleInput" type="number" step="5" min="0" max="90" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="0">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Wind Speed (v₁) m/s</label>
                            <input id="windInput" type="number" step="0.1" min="0.1" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="2.5">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Ambient Temp (°C)</label>
                            <input id="tempInput" type="number" step="0.5" min="10" max="55" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="40">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Exterior Lux (E_ext)</label>
                            <input id="luxInput" type="number" step="500" min="1000" max="120000" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="10000">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Cloud Cover (%)</label>
                            <input id="cloudCoverInput" type="number" step="5" min="0" max="100" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="80">
                        </div>
                        <div class="col-span-2">
                            <label class="block text-xs font-semibold text-stone-600 mb-1">Target Room Floor Area (m²)</label>
                            <input id="floorAreaInput" type="number" step="1" min="5" max="200" class="w-full p-2 border border-stone-300 rounded-lg text-sm bg-white" value="15">
                        </div>
                    </div>
                    <button id="initializeGridBtn" class="w-full mt-4 bg-stone-800 hover:bg-stone-950 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition shadow-sm">
                        Reconstruct Array Layout
                    </button>
                </div>

                <!-- CELL OVERRIDE PANEL -->
                <div id="localizedControllerPanel" class="p-4 bg-amber-50/60 border border-amber-200/70 rounded-xl space-y-3 hidden">
                    <div class="flex justify-between items-center">
                        <h3 class="text-xs font-bold text-amber-900 uppercase tracking-wide">Cell Customization Panel</h3>
                        <span id="selectedCellLabel" class="text-xs font-mono bg-amber-200/60 text-amber-900 px-2 py-0.5 rounded font-medium">Row: 0, Col: 0</span>
                    </div>
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="text-xs font-medium text-stone-700">Target Local Void Space</label>
                            <span id="localVpDisplay" class="text-xs font-mono font-bold text-amber-900">15.00%</span>
                        </div>
                        <input id="cellVpSlider" type="range" min="0.1" max="37.24" step="0.01" class="w-full accent-stone-700">
                        <span class="text-[10px] text-stone-400 block mt-0.5">Absolute analytical limit bound: 37.24%</span>
                    </div>
                </div>

                <!-- STRUCTURAL FEA DASHBOARD -->
                <div class="p-4 bg-rose-950 text-rose-100 rounded-xl border border-rose-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-rose-800 pb-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-rose-300">FEA Structural Stress (Wind Load)</h3>
                        <span class="text-[10px] bg-rose-900 text-rose-300 font-mono px-2 py-0.5 rounded">Rankine/Plate Model</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <span class="text-[10px] text-rose-300 block">Peak Wind Pressure</span>
                            <span id="feaWindPressure" class="font-mono font-bold text-sm text-white">0.00 Pa</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-rose-300 block">Net Wind Load</span>
                            <span id="feaNetForce" class="font-mono font-bold text-sm text-amber-300">0.00 N</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-rose-300 block">Max Stress</span>
                            <span id="feaMaxStress" class="font-mono font-bold text-sm text-white">0.000 MPa</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-rose-300 block">Max Deflection</span>
                            <span id="feaDeflection" class="font-mono font-bold text-sm text-white">0.000 mm</span>
                        </div>
                        <div class="col-span-2 border-t border-rose-800/80 pt-2 flex justify-between items-center">
                            <div>
                                <span class="text-[10px] text-rose-300 block">Safety Factor (Tensile)</span>
                                <span id="feaSafetyFactor" class="font-mono font-bold text-sm text-emerald-400">SF: 0.00</span>
                            </div>
                            <span id="feaStatusBadge" class="text-[10px] font-bold font-mono px-2 py-1 rounded bg-emerald-900 text-emerald-200">ADEQUATE</span>
                        </div>
                    </div>
                </div>

                <!-- AIRFLOW & THERMAL DASHBOARD -->
                <div class="p-4 bg-teal-900/90 text-teal-100 rounded-xl border border-teal-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-teal-700/60 pb-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-teal-300">CFD Venturi Airflow & Thermal</h3>
                        <span class="text-[10px] bg-teal-950 text-teal-300 font-mono px-2 py-0.5 rounded">Dynamic Physics</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <span class="text-[10px] text-teal-300 block">Selected Exit Speed</span>
                            <span id="simLocalV2" class="font-mono font-bold text-sm text-amber-300">0.00 m/s</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-teal-300 block">Array Avg. Speed</span>
                            <span id="simV2" class="font-mono font-bold text-sm text-white">0.00 m/s</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-teal-300 block">Pressure Drop</span>
                            <span id="simDeltaP" class="font-mono font-bold text-sm text-white">0.00 Pa</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-teal-300 block">Volumetric Flow</span>
                            <span id="simFlowRate" class="font-mono font-bold text-sm text-white">0.0000 m³/s</span>
                        </div>
                        <div class="col-span-2 border-t border-teal-800/80 pt-2 grid grid-cols-2 gap-2">
                            <div>
                                <span class="text-[10px] text-teal-300 block">Dry Convective Drop</span>
                                <span id="simDryTempDrop" class="font-mono font-bold text-sm text-amber-300">-0.0 °C</span>
                            </div>
                            <div>
                                <span class="text-[10px] text-teal-300 block">Wetted Evaporative Drop</span>
                                <span id="simEvapTempDrop" class="font-mono font-bold text-sm text-emerald-300">-0.0 °C</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DAYLIGHT DASHBOARD -->
                <div class="p-4 bg-indigo-950 text-indigo-100 rounded-xl border border-indigo-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-indigo-800 pb-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-300">Daylight & Glare Estimator</h3>
                        <span class="text-[10px] bg-indigo-900 text-indigo-300 font-mono px-2 py-0.5 rounded">Radiance Model</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <span class="text-[10px] text-indigo-300 block">Daylight Factor (DF)</span>
                            <span id="simDF" class="font-mono font-bold text-sm text-emerald-300">2.00 %</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-indigo-300 block">Daylight Glare Index (DGI)</span>
                            <span id="simDGI" class="font-mono font-bold text-sm text-white">0.00</span>
                        </div>
                        <div class="col-span-2">
                            <span class="text-[10px] text-indigo-300 block">Visual Comfort Assessment</span>
                            <span id="simGlareStatus" class="font-mono font-bold text-xs text-emerald-300">Imperceptible Glare (Optimal Comfort)</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- VIEWPORT & VISUAL SIMULATION CANVAS SUITE -->
            <div class="w-full lg:w-2/3 p-6 flex flex-col justify-between space-y-6 overflow-hidden">
                <div>
                    <!-- TAB NAVIGATION FOR VISUAL CANVAS SOLVERS -->
                    <div class="flex flex-wrap items-center justify-between border-b border-stone-200 pb-3 mb-4 gap-2">
                        <h2 class="text-sm font-bold text-stone-800 uppercase tracking-wider">3. Interactive Physics Visualizer Suite</h2>
                        <div class="flex flex-wrap gap-1">
                            <button onclick="switchSimTab('svg-matrix')" id="tabBtn-svg-matrix" class="sim-tab-btn active text-[11px] font-semibold px-3 py-1.5 rounded-lg border border-stone-300 transition">Array Matrix</button>
                            <button onclick="switchSimTab('fea-map')" id="tabBtn-fea-map" class="sim-tab-btn text-[11px] font-semibold px-3 py-1.5 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-100 transition">FEA Stress Notch</button>
                            <button onclick="switchSimTab('cfd-map')" id="tabBtn-cfd-map" class="sim-tab-btn text-[11px] font-semibold px-3 py-1.5 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-100 transition">CFD Airflow Jet</button>
                            <button onclick="switchSimTab('thermal-map')" id="tabBtn-thermal-map" class="sim-tab-btn text-[11px] font-semibold px-3 py-1.5 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-100 transition">Thermal Isotherms</button>
                            <button onclick="switchSimTab('lighting-map')" id="tabBtn-lighting-map" class="sim-tab-btn text-[11px] font-semibold px-3 py-1.5 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-100 transition">5x5 Workplane Lux</button>
                        </div>
                    </div>
                    
                    <!-- TAB 1: SVG VECTOR MATRIX -->
                    <div id="simTab-svg-matrix" class="w-full p-4 bg-stone-100 rounded-xl border border-stone-200 flex items-center justify-center overflow-auto max-h-[520px]">
                        <div id="svgContainerWrapper" class="w-full flex items-center justify-center min-h-[320px]"></div>
                    </div>

                    <!-- TAB 2: FEA STRESS & DEFORMED MESH CANVAS -->
                    <div id="simTab-fea-map" class="hidden w-full p-4 bg-stone-900 rounded-xl border border-stone-800 flex flex-col items-center justify-center">
                        <canvas id="feaCanvas" width="600" height="380" class="max-w-full rounded-lg shadow-inner bg-black"></canvas>
                        <span class="text-[10px] text-stone-400 mt-2 font-mono">Von Mises Stress Contours (MPa) & Exaggerated Deformed Mesh (50x)</span>
                    </div>

                    <!-- TAB 3: CFD AIRFLOW STREAMLINES CANVAS -->
                    <div id="simTab-cfd-map" class="hidden w-full p-4 bg-stone-900 rounded-xl border border-stone-800 flex flex-col items-center justify-center">
                        <canvas id="cfdCanvas" width="600" height="380" class="max-w-full rounded-lg shadow-inner bg-black"></canvas>
                        <span class="text-[10px] text-stone-400 mt-2 font-mono">Venturi Acceleration Velocity Profile (m/s) & Vector Airflow Streamlines</span>
                    </div>

                    <!-- TAB 4: THERMAL HEAT MAP ISOTHERMS CANVAS -->
                    <div id="simTab-thermal-map" class="hidden w-full p-4 bg-stone-900 rounded-xl border border-stone-800 flex flex-col items-center justify-center">
                        <canvas id="thermalCanvas" width="600" height="380" class="max-w-full rounded-lg shadow-inner bg-black"></canvas>
                        <span class="text-[10px] text-stone-400 mt-2 font-mono">Convective & Wetted Terracotta Evaporative Cooling Temperature Distribution (°C)</span>
                    </div>

                    <!-- TAB 5: POINT-BY-POINT WORKPLANE ILLUMINANCE CANVAS -->
                    <div id="simTab-lighting-map" class="hidden w-full p-4 bg-stone-900 rounded-xl border border-stone-800 flex flex-col items-center justify-center">
                        <canvas id="luxCanvas" width="600" height="380" class="max-w-full rounded-lg shadow-inner bg-black"></canvas>
                        <span class="text-[10px] text-stone-400 mt-2 font-mono">5x5 Workplane Point-by-Point Lux Calculations & Ceiling Downlight Inverse-Square Falloff</span>
                    </div>
                </div>

                <div>
                    <h2 class="text-sm font-bold text-stone-800 uppercase tracking-wider mb-3">4. Dynamic Mapping Matrix</h2>
                    <div id="interactiveMapGrid" class="grid gap-2 p-3 bg-stone-50 border border-stone-200 rounded-xl overflow-x-auto min-h-[100px]"></div>
                </div>

                <div class="flex gap-4 border-t border-stone-100 pt-4">
                    <div class="flex-grow">
                        <label class="block text-[10px] font-bold text-stone-400 uppercase mb-1">Export Data Vector Specification</label>
                        <textarea id="svgOutputDataBuffer" readonly class="w-full h-12 p-2 border border-stone-200 rounded-lg text-[10px] font-mono bg-stone-50 text-stone-500 select-all" placeholder="SVG trace sequence code blocks stream buffer..."></textarea>
                    </div>
                    <div class="flex items-end">
                        <button id="downloadSvgDataBtn" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold py-3 px-5 rounded-lg transition whitespace-nowrap shadow-sm">
                            Export Vector File (.svg)
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        const CM2PX = 37.79527559055118; 
        const SR3 = Math.sqrt(3); 
        const C1 = SR3 / (4 * SR3 - 2 * Math.PI); 
        const MAX_VP_LIMIT = 37.24; 

        const MATERIAL_E = 4.5e9;
        const TENSILE_LIMIT_MPA = 2.5;

        let systemState = {
            s: 30, gap: 5, th: 2, defaultVp: 15, cols: 6, rows: 3, 
            v1: 2.5, tAmbient: 40, eExt: 10000, cloudCover: 80, floorArea: 15,
            orientation: 'South', windAngle: 0,
            cells: [], selectedCellIndex: null,
            computedPhysics: {}
        };

        const ui = {
            side: document.getElementById('sideInput'),
            gap: document.getElementById('gapInput'),
            thickness: document.getElementById('thicknessInput'),
            defaultVp: document.getElementById('defaultVpInput'),
            cols: document.getElementById('colsInput'),
            rows: document.getElementById('rowsInput'),
            wind: document.getElementById('windInput'),
            temp: document.getElementById('tempInput'),
            lux: document.getElementById('luxInput'),
            cloudCover: document.getElementById('cloudCoverInput'),
            floorArea: document.getElementById('floorAreaInput'),
            orientation: document.getElementById('orientationInput'),
            windAngle: document.getElementById('windAngleInput'),
            presetHotDry: document.getElementById('presetHotDry'),
            presetComposite: document.getElementById('presetComposite'),
            presetMonsoon: document.getElementById('presetMonsoon'),
            initBtn: document.getElementById('initializeGridBtn'),
            mapGrid: document.getElementById('interactiveMapGrid'),
            svgWrapper: document.getElementById('svgContainerWrapper'),
            buffer: document.getElementById('svgOutputDataBuffer'),
            downloadBtn: document.getElementById('downloadSvgDataBtn'),
            localPanel: document.getElementById('localizedControllerPanel'),
            cellLabel: document.getElementById('selectedCellLabel'),
            cellVpSlider: document.getElementById('cellVpSlider'),
            localVpLabel: document.getElementById('localVpDisplay'),
            simLocalV2: document.getElementById('simLocalV2'),
            simV2: document.getElementById('simV2'),
            simDeltaP: document.getElementById('simDeltaP'),
            simFlowRate: document.getElementById('simFlowRate'),
            simDryTempDrop: document.getElementById('simDryTempDrop'),
            simEvapTempDrop: document.getElementById('simEvapTempDrop'),
            simDF: document.getElementById('simDF'),
            simDGI: document.getElementById('simDGI'),
            simGlareStatus: document.getElementById('simGlareStatus'),
            feaWindPressure: document.getElementById('feaWindPressure'),
            feaNetForce: document.getElementById('feaNetForce'),
            feaMaxStress: document.getElementById('feaMaxStress'),
            feaDeflection: document.getElementById('feaDeflection'),
            feaSafetyFactor: document.getElementById('feaSafetyFactor'),
            feaStatusBadge: document.getElementById('feaStatusBadge')
        };

        function switchSimTab(tabKey) {
            ['svg-matrix', 'fea-map', 'cfd-map', 'thermal-map', 'lighting-map'].forEach(k => {
                const tabEl = document.getElementById(`simTab-${k}`);
                const btnEl = document.getElementById(`tabBtn-${k}`);
                if (tabEl) tabEl.classList.add('hidden');
                if (btnEl) btnEl.classList.remove('active', 'bg-stone-900', 'text-white');
            });

            const activeTab = document.getElementById(`simTab-${tabKey}`);
            const activeBtn = document.getElementById(`tabBtn-${tabKey}`);
            if (activeTab) activeTab.classList.remove('hidden');
            if (activeBtn) activeBtn.classList.add('active', 'bg-stone-900', 'text-white');

            if (tabKey === 'fea-map') renderFeaCanvas();
            if (tabKey === 'cfd-map') renderCfdCanvas();
            if (tabKey === 'thermal-map') renderThermalCanvas();
            if (tabKey === 'lighting-map') renderLuxCanvas();
        }

        function syncInputsWithState() {
            systemState.s = parseFloat(ui.side.value) || 30;
            systemState.gap = parseFloat(ui.gap.value) || 5;
            systemState.th = parseFloat(ui.thickness.value) || 2;
            
            let rawVp = parseFloat(ui.defaultVp.value) || 15;
            if (rawVp > MAX_VP_LIMIT) rawVp = MAX_VP_LIMIT;
            systemState.defaultVp = rawVp;

            systemState.cols = parseInt(ui.cols.value) || 6;
            systemState.rows = parseInt(ui.rows.value) || 3;
            systemState.v1 = parseFloat(ui.wind.value) || 2.5;
            systemState.tAmbient = parseFloat(ui.temp.value) || 40;
            systemState.eExt = parseFloat(ui.lux.value) || 10000;
            systemState.cloudCover = parseFloat(ui.cloudCover.value) || 80;
            systemState.floorArea = parseFloat(ui.floorArea.value) || 15;
            systemState.orientation = ui.orientation.value;
            systemState.windAngle = parseFloat(ui.windAngle.value) || 0;
        }

        function initializeSystemMatrix() {
            syncInputsWithState();
            systemState.cells = [];
            systemState.selectedCellIndex = null;
            if (ui.localPanel) ui.localPanel.classList.add('hidden');

            for (let r = 0; r < systemState.rows; r++) {
                for (let c = 0; c < systemState.cols; c++) {
                    const isUpright = (r + c) % 2 === 0;
                    systemState.cells.push({ row: r, col: c, isUpright, vp: systemState.defaultVp });
                }
            }
            renderInterfaceDashboard();
        }

