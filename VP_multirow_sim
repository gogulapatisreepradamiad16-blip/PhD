        function updateSimulations() {
            syncInputsWithState();
            const rho = 1.225; 
            const windRad = (systemState.windAngle * Math.PI) / 180;
            const incidentWindFactor = Math.max(Math.cos(windRad), 0.15);
            const v1Effective = systemState.v1 * incidentWindFactor;

            const sMeter = (systemState.s / 2) / 100; 
            const tMeter = systemState.th / 100;       

            let totalFlowRate = 0, sumV2 = 0, sumDeltaP = 0, sumVP = 0;

            systemState.cells.forEach(cell => {
                const clampedVp = Math.min(cell.vp, MAX_VP_LIMIT);
                const vpRatio = Math.max(clampedVp / 100, 0.001);
                sumVP += vpRatio;

                const v2 = v1Effective / vpRatio;
                const deltaP = 0.5 * rho * (Math.pow(v2, 2) - Math.pow(v1Effective, 2));
                const moduleOuterArea = Math.pow(sMeter, 2) * SR3;
                const voidAreaM2 = moduleOuterArea * vpRatio;
                const qModule = voidAreaM2 * v2; 

                sumV2 += v2; sumDeltaP += deltaP; totalFlowRate += qModule;
            });

            const totalCells = systemState.cells.length || 1;
            const avgV2 = sumV2 / totalCells;
            const avgDeltaP = sumDeltaP / totalCells;
            const avgVpRatio = sumVP / totalCells;

            if (systemState.selectedCellIndex !== null && systemState.cells[systemState.selectedCellIndex]) {
                const selVp = Math.max(Math.min(systemState.cells[systemState.selectedCellIndex].vp, MAX_VP_LIMIT) / 100, 0.001);
                ui.simLocalV2.textContent = `${(v1Effective / selVp).toFixed(2)} m/s`;
            } else {
                ui.simLocalV2.textContent = `Select a Block`;
            }

            ui.simV2.textContent = `${avgV2.toFixed(2)} m/s`;
            ui.simDeltaP.textContent = `${avgDeltaP.toFixed(1)} Pa`;
            ui.simFlowRate.textContent = `${totalFlowRate.toFixed(4)} m³/s`;

            const dryDrop = 1.35 * Math.log(avgV2 / v1Effective || 1);
            const rhEstimate = Math.min(Math.max(systemState.cloudCover, 15), 95);
            const tWetBulb = systemState.tAmbient * (0.15 + (rhEstimate / 200) + 0.3); 
            const evapDrop = Math.max((systemState.tAmbient - tWetBulb) * 0.68, 0);

            ui.simDryTempDrop.textContent = `-${dryDrop.toFixed(1)} °C`;
            ui.simEvapTempDrop.textContent = `-${evapDrop.toFixed(1)} °C`;

            let orientationSolarMultiplier = 1.0;
            if (systemState.orientation === 'North') orientationSolarMultiplier = 0.50;
            if (systemState.orientation === 'South') orientationSolarMultiplier = 1.25;
            if (systemState.orientation === 'East' || systemState.orientation === 'West') orientationSolarMultiplier = 0.95;

            const bMeter = sMeter * Math.sqrt(avgVpRatio * C1);
            const depthAspect = tMeter / (bMeter * SR3 || 0.01);
            const fDepth = Math.max(1 / (1 + 1.2 * depthAspect), 0.2); 

            const moduleOuterAreaM2 = Math.pow(sMeter, 2) * SR3;
            const totalScreenVoidAreaM2 = moduleOuterAreaM2 * sumVP;
            const userFloorArea = Math.max(systemState.floorArea, 1.0);
            
            const rawDaylightFactor = (totalScreenVoidAreaM2 / userFloorArea) * 0.85 * 100 * 2.8 * fDepth * orientationSolarMultiplier;
            const skyCloudOpacity = 1 - (systemState.cloudCover / 200);
            const effectiveLux = systemState.eExt * orientationSolarMultiplier * skyCloudOpacity;
            const cavityLuminance = (effectiveLux / Math.PI) * avgVpRatio * fDepth;
            const dgi = 10 * Math.log10(Math.max(0.35 * Math.pow(cavityLuminance, 1.4) * Math.pow(avgVpRatio, 0.8), 1));

            ui.simDF.textContent = `${rawDaylightFactor.toFixed(2)} %`;
            ui.simDGI.textContent = `${Math.max(dgi, 0).toFixed(1)}`;

            // FEA Wind Load Stress Model
            const qz = 0.5 * rho * Math.pow(v1Effective, 2);
            const totalGrossAreaM2 = moduleOuterAreaM2 * totalCells;
            const netSolidAreaM2 = totalGrossAreaM2 * (1 - avgVpRatio);
            const F_net = qz * 1.2 * netSolidAreaM2;

            const screenHeightM = systemState.rows * (sMeter * SR3);
            const M_max = (F_net * screenHeightM) / 8;
            
            const wallWidthM = (systemState.cols + 1) * sMeter;
            const I_net = (tMeter * Math.pow(wallWidthM, 3) * (1 - avgVpRatio)) / 12;
            const Kt = 1.5 + (avgVpRatio * 1.8);
            const sigma_1_MPa = ((M_max * (wallWidthM / 2) / Math.max(I_net, 1e-8)) * Kt) / 1e6;
            const delta_mm = ((5 * F_net * Math.pow(screenHeightM, 3)) / (384 * MATERIAL_E * Math.max(I_net, 1e-8))) * 1000;
            const safetyFactor = TENSILE_LIMIT_MPA / Math.max(sigma_1_MPa, 0.001);

            ui.feaWindPressure.textContent = `${qz.toFixed(2)} Pa`;
            ui.feaNetForce.textContent = `${F_net.toFixed(2)} N`;
            ui.feaMaxStress.textContent = `${sigma_1_MPa.toFixed(3)} MPa`;
            ui.feaDeflection.textContent = `${delta_mm.toFixed(3)} mm`;
            ui.feaSafetyFactor.textContent = `SF: ${safetyFactor.toFixed(2)}`;

            systemState.computedPhysics = {
                v1Effective, avgV2, avgDeltaP, dryDrop, evapDrop,
                rawDaylightFactor, effectiveLux, avgVpRatio,
                sigma_1_MPa, delta_mm, safetyFactor, F_net
            };
        }

        function generateVectorMatrixOutput() {
            const s = (systemState.s / 2) * CM2PX; 
            const th = systemState.th * CM2PX;    
            const h = s * SR3;                    

            const colWidthStep = s; rowHeightStep = h; 
            const paddingShift = th * 4;
            const totalWidth = colWidthStep * (systemState.cols + 1) + (paddingShift * 2);
            const totalHeight = rowHeightStep * systemState.rows + (paddingShift * 2);

            let svgContent = `<?xml version="1.0" encoding="UTF-8" standalone="no"?>\n`; 
            svgContent += `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${totalWidth} ${totalHeight}" width="100%" height="100%" style="background-color: #ffffff;">\n`;
            svgContent += `  <g transform="translate(${paddingShift}, ${paddingShift})">\n`;

            systemState.cells.forEach((cell) => {
                const deltaX = cell.col * colWidthStep;
                const deltaY = cell.row * rowHeightStep;

                svgContent += `    <g transform="translate(${deltaX}, ${deltaY})">\n`;
                if (cell.isUpright) {
                    svgContent += generateUprightBlock(s, h, th, Math.min(cell.vp, MAX_VP_LIMIT));
                } else {
                    svgContent += generateInvertedBlock(s, h, th, Math.min(cell.vp, MAX_VP_LIMIT));
                }
                svgContent += `    </g>\n`;
            });

            svgContent += `  </g>\n</svg>`;

            if (ui.svgWrapper) ui.svgWrapper.innerHTML = svgContent;
            if (ui.buffer) ui.buffer.value = svgContent;
        }

        function generateUprightBlock(s, h, th, vp) {
            const b = s * Math.sqrt((vp / 100) * C1); 
            const r = b * 2; const R = (s + s) / SR3;                  
            const innerRadius = (b + b) / SR3; const tInner = (s - b) / SR3;             

            const Ap = { x: 0, y: h }, Bp = { x: s, y: 0 }, Cp = { x: s * 2, y: h };
            const Gp = { x: s - b, y: h - tInner }, Hp = { x: s, y: R - innerRadius }, Ip = { x: s + b, y: h - tInner };

            let pathStr = "";
            pathStr += `      <path d="M ${Ap.x} ${Ap.y} L ${Bp.x} ${Bp.y} L ${Cp.x} ${Cp.y} Z" fill="#000000" stroke="#ffffff" stroke-width="1" />\n`;
            pathStr += `      <path d="M ${Gp.x} ${Gp.y} A ${r} ${r} 0 0 1 ${Ip.x} ${Ip.y} A ${r} ${r} 0 0 1 ${Hp.x} ${Hp.y} A ${r} ${r} 0 0 1 ${Gp.x} ${Gp.y} Z" fill="#ffffff" />\n`;
            return pathStr;
        }

        function generateInvertedBlock(s, h, th, vp) {
            const b = s * Math.sqrt((vp / 100) * C1);
            const r = b * 2; const R = (s + s) / SR3;
            const innerRadius = (b + b) / SR3; const tInner = (s - b) / SR3;

            const Bp = { x: 0, y: 0 }, Ap = { x: s, y: h }, Cp = { x: s * 2, y: 0 };
            const Gp = { x: s - b, y: tInner }, Hp = { x: s, y: h - (R - innerRadius) }, Ip = { x: s + b, y: tInner };

            let pathStr = "";
            pathStr += `      <path d="M ${Bp.x} ${Bp.y} L ${Ap.x} ${Ap.y} L ${Cp.x} ${Cp.y} Z" fill="#000000" stroke="#ffffff" stroke-width="1" />\n`;
            pathStr += `      <path d="M ${Gp.x} ${Gp.y} A ${r} ${r} 0 0 0 ${Ip.x} ${Ip.y} A ${r} ${r} 0 0 0 ${Hp.x} ${Hp.y} A ${r} ${r} 0 0 0 ${Gp.x} ${Gp.y} Z" fill="#ffffff" />\n`;
            return pathStr;
        }

